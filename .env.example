# Copy to .env and fill in. .env is gitignored.

# Which LLM backend to use: "ollama" (local, default) or "openai"
MIIU_PROVIDER=ollama

# Only needed for MIIU_PROVIDER=openai
OPENAI_API_KEY=

# Optional: override the model (default gemma4-pi for ollama, gpt-5-mini for openai)
# MIIU_MODEL=

# Optional (openai, gpt-5 family): faster replies with less reasoning, e.g. minimal or low
# MIIU_OPENAI_REASONING=low
