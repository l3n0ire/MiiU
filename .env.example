# Copy to .env and fill in. .env is gitignored.

# Which LLM backend to use: "ollama" (local, default) or "openai"
MIIU_PROVIDER=ollama

# Only needed for MIIU_PROVIDER=openai
OPENAI_API_KEY=

# Optional: override the model (default gemma4-pi for ollama, gpt-6-luna for openai)
# MIIU_MODEL=

# Optional (openai): faster replies with less reasoning, e.g. low
# MIIU_OPENAI_REASONING=low
